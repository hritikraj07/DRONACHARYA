# Dronacharya Environment Configuration Example
# Copy this file to .env.local to activate external AI and database services

# Required: Google Gemini API Key for Live Context-Aware AI Mentor (gemini-2.5-flash)
# Used by POST /api/mentor/ask to diagnose active code and generate exact working solutions
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: PostgreSQL / Supabase Database Connection URL
# If not provided, Dronacharya runs with resilient local state persistence
DATABASE_URL=postgresql://postgres:password@localhost:5432/dronacharya

# NextAuth / JWT Secret
NEXTAUTH_SECRET=dronacharya_super_secret_jwt_key_2026
NEXTAUTH_URL=http://localhost:3000
